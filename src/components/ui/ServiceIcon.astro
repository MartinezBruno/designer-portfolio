---
import IconVector from '@tabler/icons/outline/vector.svg';
import IconLayout from '@tabler/icons/outline/layout.svg';
import IconPalette from '@tabler/icons/outline/palette.svg';
import IconSpeakerphone from '@tabler/icons/outline/speakerphone.svg';
import type { ServiceIconKey } from '../../lib/content/icons';

interface Props {
  name: ServiceIconKey;
}

// Explicit per-file imports (no barrels). A missing or unknown key is a type error.
const icons = {
  vector: IconVector,
  layout: IconLayout,
  palette: IconPalette,
  speakerphone: IconSpeakerphone,
} as const satisfies Record<ServiceIconKey, typeof IconLayout>;

const Icon = icons[Astro.props.name];
---

<Icon aria-hidden="true" focusable="false" class="text-ink size-6" />
