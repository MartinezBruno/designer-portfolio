---
import IconMail from '@tabler/icons/outline/mail.svg';
import SocialLinks from '../ui/SocialLinks.astro';
import { site } from '../../data/site';
import { interpolate, useTranslations, type Locale } from '../../i18n/t';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
const copyright = interpolate(t('footer.copyright'), { year: new Date().getFullYear() });
---

<footer class="bg-surface-alt py-12">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 sm:px-6 lg:px-8">
    <h2 class="font-display text-2xl">{t('footer.heading')}</h2>
    <p>
      <a
        href={`mailto:${site.email}`}
        class="decoration-accent focus-visible:outline-accent inline-flex min-h-11 items-center gap-1 text-base underline-offset-4 hover:underline focus-visible:underline focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        <IconMail aria-hidden="true" focusable="false" class="size-5" />
        {site.email}
      </a>
    </p>
    <SocialLinks locale={Astro.props.locale} />
    <p class="text-ink-muted text-base">{copyright}</p>
  </div>
</footer>
