---
import { primaryButton } from '../../lib/ui/button-classes';

// Accent pill CTA. Reused by the hero and the 404 view. Default slot = label, "icon" slot trails it.
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a href={href} class={primaryButton}>
  <slot />
  <slot name="icon" />
</a>
