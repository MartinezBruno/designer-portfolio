# Server secrets for the contact form (D-20, D-21). Names only, never real values.
# Copy to .dev.vars (gitignored) for `astro dev`. The e2e run writes its own values
# (scripts/e2e-preview-env.ts), so this file does not affect tests.
# PUBLIC_TURNSTILE_SITE_KEY must never go in .dev.vars or .env: it ships to the client.

# Local/e2e only: allows MAILER=console and Cloudflare's Turnstile test keys. Never set it in a
# deploy: without it, the console mailer or a test key makes every send fail closed (the visitor
# gets the failure block and mailto) instead of a false "Message sent".
CONTACT_ALLOW_TEST_CONFIG=true

# console | cloudflare | resend. console logs the message instead of sending it; cloudflare sends
# through the EMAIL send_email binding (wrangler.jsonc); resend sends through Resend.
# A deploy sets MAILER=cloudflare, or resend (console is refused unless
# CONTACT_ALLOW_TEST_CONFIG=true). MAILER=cloudflare in local dev uses the simulated binding: it
# logs and writes an .eml file, nothing is sent [Unverified for astro dev].
MAILER=console

# The only recipient (D-21). For cloudflare it must be the verified Email Routing destination
# (destination_address in wrangler.jsonc); for resend with onboarding@resend.dev it must be the
# Resend account owner's address.
CONTACT_TO=

RESEND_API_KEY=

# Dev/CI uses Cloudflare's always-pass test secret 1x0000000000000000000000000000000AA.
TURNSTILE_SECRET_KEY=
