---
/**
 * One featured service card. Only the explicit "Ask about this" text link is interactive (D-05):
 * the card itself has no pointer cursor, hover change or stretched link. The link's accessible
 * name is "Ask about this: Branding", so the 4 links are distinct and still start with the visible
 * label (WCAG 2.5.3). The whole name sits in one sr-only span and the visible label is
 * aria-hidden: Chromium inserts a space before an absolutely positioned sr-only fragment, which
 * read "Ask about this : Branding". The section builds the href with the stable service id (D-08).
 */
import IconArrowRight from '@tabler/icons/outline/arrow-right.svg';
import ServiceIcon from './ServiceIcon.astro';
import { interpolate, useTranslations, type Locale } from '../../i18n/t';
import type { ServiceIconKey } from '../../lib/content/icons';

interface Props {
  title: string;
  items: readonly string[];
  icon: ServiceIconKey;
  href: string;
  locale: Locale;
}

const { title, items, icon, href, locale } = Astro.props;
const t = useTranslations(locale);
---

<li class="bg-surface-alt flex h-full flex-col gap-4 rounded-2xl p-6">
  <span class="bg-surface grid size-12 place-items-center rounded-full">
    <ServiceIcon name={icon} />
  </span>
  <div class="flex flex-col gap-2">
    <h3 class="text-ink text-base font-semibold">{title}</h3>
    <ul class="text-ink-muted marker:text-ink-muted list-disc space-y-1 pl-6 text-base">
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
  <p class="mt-auto">
    <a
      href={href}
      class="text-ink decoration-accent focus-visible:outline-accent inline-flex min-h-11 items-center gap-2 text-base font-semibold decoration-2 underline-offset-4 hover:underline focus-visible:underline focus-visible:outline-2 focus-visible:outline-offset-2"
    >
      <span aria-hidden="true">{t('services.ask')}</span>
      <span class="sr-only">
        {t('services.ask')}
        {interpolate(t('services.askTarget'), { title })}
      </span>
      <IconArrowRight aria-hidden="true" focusable="false" class="size-5" />
    </a>
  </p>
</li>
