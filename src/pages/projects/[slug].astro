---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDetailView from '../../components/views/ProjectDetailView.astro';
import { getProjectPaths } from '../../lib/content/queries';
import type { ProjectDetailView as Detail } from '../../lib/projects/model';

export function getStaticPaths() {
  return getProjectPaths('en');
}

interface Props {
  detail: Detail;
}

const { detail } = Astro.props;

// JPG for crawler support. The URL comes only from getImage output and astro.config `site`.
if (Astro.site === undefined) {
  throw new Error('seo: astro.config site is not set. Set it in astro.config.mjs');
}
const og = await getImage({ src: detail.cover, width: 1200, format: 'jpg' });
const ogImage = new URL(og.src, Astro.site).href;
---

<BaseLayout
  locale="en"
  title={detail.seo.title}
  description={detail.seo.description}
  ogImage={ogImage}
>
  <ProjectDetailView locale="en" detail={detail} />
</BaseLayout>
