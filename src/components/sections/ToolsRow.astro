---
import ToolIcon from '../ui/ToolIcon.astro';
import type { ToolView } from '../../lib/content/home';
import { useTranslations, type Locale } from '../../i18n/t';

// Tools (HOME-05). Redesign: every tool shows its name as visible text beside its mark, so touch
// users and anyone who does not know a brand mark can read it (supersedes the icon-only tiles and
// hover/focus tooltips of D-12..D-14). Nothing here is interactive, so nothing is a tab stop; the
// mark is decorative and the visible name is the accessible text.
interface Props {
  tools: readonly ToolView[];
  locale: Locale;
}

const { tools, locale } = Astro.props;
const t = useTranslations(locale);
---

<section aria-labelledby="tools-title" class="bg-surface-alt py-20 lg:py-28">
  <div class="mx-auto flex w-full max-w-[88rem] flex-col gap-10 px-4 sm:px-8 lg:gap-14 lg:px-12">
    <h2
      id="tools-title"
      data-reveal="lines"
      class="font-display text-section max-w-[16ch] font-semibold text-balance"
    >
      {t('tools.heading')}
    </h2>
    <ul class="flex flex-wrap gap-x-10 gap-y-5 lg:gap-x-14" data-reveal-stagger="70">
      {tools.map((tool) => (
        <li
          data-tool
          data-reveal="settle"
          data-reveal-delay="140"
          class="text-ink inline-flex items-center gap-3 [--reveal-travel:12px]"
        >
          <span class="bg-surface grid size-12 shrink-0 place-items-center rounded-full sm:size-14">
            <ToolIcon name={tool.icon} />
          </span>
          <span class="text-lead font-semibold">{tool.name}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
