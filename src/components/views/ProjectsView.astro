---
import { getRelativeLocaleUrl } from 'astro:i18n';
import CategoryFilter from '../ui/CategoryFilter.astro';
import ProjectGrid from '../ui/ProjectGrid.astro';
import { getAllProjects } from '../../lib/content/queries';
import { buildCategoryChips } from '../../lib/projects/filter';
import { categoryPrefilterInline } from '../../lib/projects/category-prefilter';
import { useTranslations, type Locale } from '../../i18n/t';

interface Props {
  locale: Locale;
}

// ProjectsView is the only project reader for this page; the grid and cards stay prop-driven.
const { locale } = Astro.props;
const t = useTranslations(locale);
const contactHref = `${getRelativeLocaleUrl(locale, '/')}#contact`;
const all = await getAllProjects(locale);
// All plus each non-empty category in services.json order; [] (no chip row) below two categories.
const chips = buildCategoryChips(all);
// Blocking pre-filter right after the grid: a shared ?category= link paints filtered (WR-02).
const prefilter = categoryPrefilterInline(all.length);
---

<section
  aria-labelledby="projects-title"
  class="mx-auto flex w-full max-w-[88rem] flex-col gap-12 px-4 py-16 sm:px-8 lg:px-12"
>
  <div class="flex flex-col gap-6">
    <h1
      id="projects-title"
      tabindex="-1"
      data-reveal="lines"
      class="font-display text-display -ml-[0.04em] font-semibold"
    >
      {t('projects.heading')}
    </h1>
    <p
      data-reveal="settle"
      data-reveal-delay="140"
      class="text-ink text-lead max-w-[46ch] text-pretty"
    >
      {t('projects.intro')}
    </p>
  </div>
  {all.length > 0 ? (
    <div class="flex flex-col gap-8">
      {chips.length > 0 && <CategoryFilter locale={locale} chips={chips} />}
      <ProjectGrid projects={all} variant="full" headingLevel={2} locale={locale} eagerFirst />
      {chips.length > 0 && <script is:inline set:html={prefilter} />}
    </div>
  ) : (
    <div data-reveal="settle" class="flex flex-col gap-4">
      <h2 class="font-display text-2xl font-semibold tracking-tight">
        {t('projects.empty.heading')}
      </h2>
      <p class="text-ink text-base">{t('projects.empty.body')}</p>
      <p>
        <a
          href={contactHref}
          class="text-ink decoration-accent focus-visible:outline-accent inline-flex min-h-11 items-center gap-2 text-base font-semibold decoration-2 underline-offset-4 hover:underline focus-visible:underline focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          {t('projects.empty.cta')}
        </a>
      </p>
    </div>
  )}
</section>
