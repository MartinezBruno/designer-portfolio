---
/** Renders one ModuleView by kind. Components get props only, never Behance shapes (DATA-06). */
import CollectionModule from './CollectionModule.astro';
import EmbedFacade from './EmbedFacade.astro';
import ImageModule from './ImageModule.astro';
import TextModule from './TextModule.astro';
import UnknownModule from './UnknownModule.astro';
import type { Locale } from '../../i18n/t';
import type { ModuleView } from '../../lib/projects/model';

interface Props {
  module: ModuleView;
  behanceUrl: string;
  locale: Locale;
}

const { module, behanceUrl, locale } = Astro.props;
---

{module.kind === 'image' ? (
  <ImageModule
    image={module.image}
    alt={module.alt}
    widths={module.widths}
    fullBleed={module.fullBleed}
    caption={module.caption}
    captionLang={module.captionLang}
    eager={module.eager}
    entrance={module.entrance}
  />
) : module.kind === 'collection' ? (
  <CollectionModule rows={module.rows} />
) : module.kind === 'text' ? (
  <TextModule html={module.html} lang={module.lang} />
) : module.kind === 'embed' ? (
  <EmbedFacade module={module} behanceUrl={behanceUrl} locale={locale} />
) : (
  // 'unknown': the D-08 fallback, also what a non-allowlisted embed becomes at view-build time.
  <UnknownModule behanceUrl={behanceUrl} locale={locale} />
)}
