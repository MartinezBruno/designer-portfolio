---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotFoundView from '../../components/views/NotFoundView.astro';
import { useTranslations } from '../../i18n/t';

// On demand, not prerendered: a static dist/client/es/404/index.html would be served by the
// Workers asset layer as HTTP 200. Rendered by the Worker, Astro gives it status 404 (WR-03, D-17).
export const prerender = false;

const t = useTranslations('es');
---

<BaseLayout
  locale="es"
  kind="notFound"
  title={t('meta.404.title')}
  description={t('meta.404.description')}
>
  <NotFoundView locale="es" showAltLocale={false} />
</BaseLayout>
