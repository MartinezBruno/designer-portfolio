---
// Availability line (HOME-07): a plain status line beside the hero CTA, no pill. Renders nothing when available is false (D-08): no closed state.
import { useTranslations, type Locale } from '../../i18n/t';

interface Props {
  available: boolean;
  locale: Locale;
}

const { available, locale } = Astro.props;
const t = useTranslations(locale);
---

{available && (
  <p class="text-ink-muted inline-flex items-center gap-2 text-base">
    <span aria-hidden="true" class="bg-success size-2 rounded-full" />
    {t('availability.open')}
  </p>
)}
