---
import { Picture } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import IconArrowRight from '@tabler/icons/outline/arrow-right.svg';
import AvailabilityBadge from '../ui/AvailabilityBadge.astro';
import ButtonLink from '../ui/ButtonLink.astro';
import { site } from '../../data/site';
import { useTranslations, type Locale } from '../../i18n/t';
import { pictureFormat } from '../../lib/ui/picture-format';
// TODO(martina): supply the original uncropped photo at >=1000px so the hero portrait can grow
import portrait from '../../assets/hero/portrait.png';

interface Props {
  locale: Locale;
  available: boolean;
}

const { locale, available } = Astro.props;
const t = useTranslations(locale);
const contactHref = `${getRelativeLocaleUrl(locale, '/')}#contact`;
---

<section
  data-hero
  aria-labelledby="hero-title"
  class="mx-auto max-w-[88rem] px-4 pt-10 pb-14 sm:px-8 sm:pt-14 lg:px-12 lg:pt-20 lg:pb-20"
>
  <div class="grid grid-cols-1 gap-x-8 gap-y-10 lg:grid-cols-12">
    <!-- Greeting is the headline: always exactly two lines, never an eyebrow above it. -->
    <h1
      id="hero-title"
      tabindex="-1"
      class="font-display text-display -ml-[0.05em] font-semibold lg:col-span-9 lg:self-end"
    >
      <span class="block" data-hero-line>
        <span class="block" data-hero-line-inner>
          {t('hero.greeting')}
        </span>
      </span>{' '}
      <span class="block" data-hero-line>
        <span class="block" data-hero-line-inner>
          {site.firstName}.
        </span>
      </span>
    </h1>
    <div class="order-first lg:order-none lg:col-span-3 lg:self-start lg:justify-self-end">
      <!-- The portrait asset is a 321px circle crop on white; it never renders past its pixels. -->
      <Picture
        src={portrait}
        {...pictureFormat}
        alt={t('hero.imageAlt')}
        loading="eager"
        fetchpriority="high"
        width={321}
        height={324}
        pictureAttributes={{
          'data-hero-portrait': '',
          class: 'block w-32 sm:w-44 lg:w-64 min-[87.5rem]:w-[19rem]',
        }}
        class="aspect-square w-full rounded-full object-contain"
      />
    </div>
    <p data-hero-lead class="text-ink text-lead max-w-[46ch] text-pretty lg:col-span-6 lg:pt-2">
      {`${t('hero.role')} ${t('hero.description')}`}
    </p>
    <div
      data-hero-cta
      class="flex flex-col items-start gap-x-8 gap-y-5 sm:flex-row sm:flex-wrap sm:items-center lg:col-span-6 lg:flex-row-reverse lg:justify-start lg:self-start"
    >
      <ButtonLink href={contactHref}>
        {t('hero.cta')}
        <Fragment slot="icon">
          <IconArrowRight aria-hidden="true" focusable="false" class="size-5" />
        </Fragment>
      </ButtonLink>
      <AvailabilityBadge available={available} locale={locale} />
    </div>
  </div>
</section>

<script>
  import { lifecycle } from '../../lib/motion';
  import { createHeroPlayed } from '../../lib/motion/hero';
  lifecycle.register(createHeroPlayed());
</script>
