---
import Hero from '../sections/Hero.astro';
import RolesMarquee from '../sections/RolesMarquee.astro';
import FeaturedServices from '../sections/FeaturedServices.astro';
import ToolsRow from '../sections/ToolsRow.astro';
import LatestWork from '../sections/LatestWork.astro';
import ContactSection from '../contact/ContactSection.astro';
import { getHomeContent, getLatestProjects } from '../../lib/content/queries';
import type { Locale } from '../../i18n/t';

interface Props {
  locale: Locale;
}

// HomeView is the only content reader for the homepage; sections stay prop-driven.
const { locale } = Astro.props;
const { available, roles, services, tools } = await getHomeContent(locale);
const latest = await getLatestProjects(locale);
---

<Hero locale={locale} available={available} />
<RolesMarquee roles={roles} locale={locale} />
<div class="flex flex-col gap-16 py-16">
  <FeaturedServices services={services} locale={locale} />
  <LatestWork projects={latest} locale={locale} />
  <ToolsRow tools={tools} locale={locale} />
  <ContactSection locale={locale} />
</div>
