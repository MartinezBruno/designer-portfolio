---
/**
 * Home "Latest work" (HOME-06 as amended by D-17). Prop-driven: HomeView reads the selection
 * (featured first, then newest, max 3). With no visible projects the whole section is omitted.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import IconArrowRight from '@tabler/icons/outline/arrow-right.svg';
import ProjectGrid from '../ui/ProjectGrid.astro';
import { useTranslations, type Locale } from '../../i18n/t';
import type { ProjectCardView } from '../../lib/projects/model';

interface Props {
  projects: readonly ProjectCardView[];
  locale: Locale;
}

const { projects, locale } = Astro.props;
const t = useTranslations(locale);
---

{projects.length > 0 && (
  <section
    aria-labelledby="work-title"
    class="mx-auto flex w-full max-w-6xl flex-col gap-8 px-4 sm:px-6 lg:px-8"
  >
    <h2
      id="work-title"
      data-reveal="lines"
      class="font-display text-2xl font-semibold tracking-tight"
    >
      {t('work.heading')}
    </h2>
    <ProjectGrid
      projects={projects}
      variant="compact"
      headingLevel={3}
      locale={locale}
      layout="row"
    />
    <p data-reveal="settle" data-reveal-delay="280">
      <!-- Magnetic (D-12): the link keeps hit area and outline; the face (and its underline) moves.
           The reveal stays on the <p>, never on the magnetic element. -->
      <a
        href={getRelativeLocaleUrl(locale, 'projects')}
        data-magnetic="link"
        class="group/link text-ink focus-visible:outline-accent inline-flex min-h-11 items-center text-base font-semibold focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        <span
          data-magnetic-face
          class="decoration-accent inline-flex items-center gap-2 decoration-2 underline-offset-4 group-hover/link:underline group-focus-visible/link:underline"
        >
          {t('work.seeAll')}
          <IconArrowRight aria-hidden="true" focusable="false" class="size-5" />
        </span>
      </a>
    </p>
  </section>
)}
