---
/**
 * One project tile (D-19). No card box: the cover and text sit on the page surface. The title
 * link is stretched over the whole tile, so each card is a single tab stop. The title link opens
 * the project detail page (Phase 4).
 */
import { Picture } from 'astro:assets';
import { sizesFor, type TileSize } from '../../lib/projects/layout';
import type { ProjectCardView } from '../../lib/projects/model';
import { pictureFormat } from '../../lib/ui/picture-format';
import { useTranslations, type Locale } from '../../i18n/t';

interface Props {
  project: ProjectCardView;
  variant: 'compact' | 'full';
  headingLevel: 2 | 3;
  locale: Locale;
  /** Grid position size from tileSize() (D-18). */
  size: TileSize;
  /** Loads the cover eagerly with high fetch priority (the first Projects tile only). */
  eager: boolean;
}

const { project, variant, headingLevel, locale, size, eager } = Astro.props;
const t = useTranslations(locale);
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const full = variant === 'full';

// Tile span and cover aspect come from data-tile through literal Tailwind data variants, so
// Tailwind sees every class at build time. The category filter re-flows the grid by rewriting
// data-tile (and `sizes`) only; it never adds classes (09-03 DOM contract, UI-SPEC grid rhythm).
// large, large-end: 5/4. small: 5/4, then 7/8 from md. third: 4/5.
const tileClass =
  'group/tile md:data-[tile=large]:col-span-7 md:data-[tile=small]:col-span-5 md:data-[tile=large-end]:col-span-8 md:data-[tile=large-end]:col-start-3 md:data-[tile=third]:col-span-4';
const frameClass =
  'bg-surface-alt overflow-clip aspect-[5/4] md:group-data-[tile=small]/tile:aspect-[7/8] group-data-[tile=third]/tile:aspect-[4/5]';
// Spread so lazy covers carry no fetchpriority attribute at all (exactOptionalPropertyTypes).
const priority = eager ? { fetchpriority: 'high' as const } : {};
// The eager cover is the LCP image: it is never clipped or hidden, so it gets no shutter.
const shutter = eager ? {} : { 'data-reveal': 'shutter' as const };
// Parallax (07-08, D-09): for the same reason the eager cover never drifts. The frame is
// overflow-clip so a named view timeline on it drives the image (Research Pitfall 5).
const parallaxFrame = eager ? {} : { 'data-parallax-frame': '' };
const parallaxImage = eager ? {} : { 'data-parallax': '' };
---

<li class={tileClass} data-tile={size} data-category={project.categoryId ?? ''}>
  <article data-card data-cursor="view" class="group/card relative flex flex-col gap-4">
    <div class={frameClass} {...shutter} {...parallaxFrame}>
      <Picture
        src={project.cover}
        alt={project.coverAlt}
        {...pictureFormat}
        widths={[404, 640, 808]}
        sizes={sizesFor[size]}
        width={project.cover.width}
        height={project.cover.height}
        loading={eager ? 'eager' : 'lazy'}
        {...priority}
        decoding="async"
        pictureAttributes={{ 'data-card-mat': '', class: 'block size-full' }}
        data-card-image
        {...parallaxImage}
        class="size-full object-cover object-center"
      />
    </div>
    <div class="flex flex-col gap-2" data-reveal="settle" data-reveal-delay="70">
      <Heading
        class:list={[
          'text-ink text-pretty',
          full
            ? 'font-display text-4xl font-semibold tracking-tight'
            : 'font-display text-2xl font-semibold tracking-tight',
        ]}
      >
        <a
          href={project.href}
          class="text-ink decoration-accent group-hover/card:underline focus-visible:after:outline-accent decoration-2 underline-offset-4 outline-hidden after:absolute after:inset-0 after:content-[''] focus-visible:underline focus-visible:after:outline-2 focus-visible:after:outline-offset-4"
        >
          {project.titleLang === null ? (
            project.title
          ) : (
            <span lang={project.titleLang}>{project.title}</span>
          )}
        </a>
      </Heading>
      {full && project.summary !== null && (
        <p class="text-ink max-w-[60ch] text-lead">{project.summary}</p>
      )}
      <dl class="text-ink-muted flex flex-wrap gap-x-4 gap-y-1 text-base">
        {project.category !== null && (
          <div class="flex gap-1">
            <dt class="sr-only">{t('projects.meta.category')}</dt>
            <dd>{project.category}</dd>
          </div>
        )}
        {full && project.tools.length > 0 && (
          <div class="flex basis-full gap-1">
            <dt class="sr-only">{t('projects.meta.tools')}</dt>
            <dd>{project.tools.join(', ')}</dd>
          </div>
        )}
      </dl>
    </div>
  </article>
</li>
