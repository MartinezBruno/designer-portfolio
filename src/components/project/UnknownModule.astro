---
/**
 * Quiet fallback for a module the site cannot mirror (D-08): an unknown Behance type or a
 * non-allowlisted embed. Not an error for the visitor, so no icon, box or warning colour.
 */
import ExternalTextLink from '../ui/ExternalTextLink.astro';
import { useTranslations, type Locale } from '../../i18n/t';

interface Props {
  behanceUrl: string;
  locale: Locale;
}

const { behanceUrl, locale } = Astro.props;
const t = useTranslations(locale);
---

<div class="mx-auto w-full max-w-[88rem] px-4 py-12 sm:px-8 lg:px-12">
  <p class="text-ink text-base">{t('detail.unknown.body')}</p>
  <p>
    <ExternalTextLink href={behanceUrl} locale={locale}>
      {t('detail.unknown.link')}
    </ExternalTextLink>
  </p>
</div>
