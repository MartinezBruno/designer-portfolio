---
import IconArrowUpRight from '@tabler/icons/outline/arrow-up-right.svg';
import { useTranslations, type Locale } from '../../i18n/t';

// Text form of the IconLink new-tab pattern. The visible slot text is the accessible name, so
// there is no aria-label; the sr-only hint ends it. rel blocks reverse tabnabbing (T-04-03).
interface Props {
  href: string;
  locale: Locale;
}

const { href, locale } = Astro.props;
const t = useTranslations(locale);
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="text-ink decoration-accent focus-visible:outline-accent inline-flex min-h-11 items-center gap-2 text-base font-semibold decoration-2 underline-offset-4 hover:underline focus-visible:underline focus-visible:outline-2 focus-visible:outline-offset-2"
>
  <slot />
  <span class="sr-only">{t('a11y.newTab')}</span>
  <IconArrowUpRight aria-hidden="true" focusable="false" class="size-4" />
</a>
