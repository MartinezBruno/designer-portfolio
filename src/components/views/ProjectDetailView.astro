---
import NextProjectTeaser from '../project/NextProjectTeaser.astro';
import ProjectContactBand from '../project/ProjectContactBand.astro';
import ProjectIntro from '../project/ProjectIntro.astro';
import ProjectModule from '../project/ProjectModule.astro';
import type { Locale } from '../../i18n/t';
import type { ProjectDetailView } from '../../lib/projects/model';

// Detail page body. The module stack follows the intro band inside the article. The page ends with
// the contact band, then the next-project teaser (omitted with 1 visible project). No motion (D-04).
interface Props {
  detail: ProjectDetailView;
  locale: Locale;
}

const { detail, locale } = Astro.props;
---

<article aria-labelledby="project-title">
  <ProjectIntro detail={detail} locale={locale} />
  {/* Edge-to-edge module stack (D-01): no gap, no padding, no lang wrapper (text roots carry lang). */}
  <div class="mx-auto flex w-full max-w-[1400px] flex-col">
    {detail.modules.map((module) => (
      <ProjectModule module={module} behanceUrl={detail.behanceUrl} locale={locale} />
    ))}
  </div>
</article>
<ProjectContactBand locale={locale} />
{detail.next !== null && (
  <NextProjectTeaser next={detail.next} previous={detail.previous} locale={locale} />
)}
