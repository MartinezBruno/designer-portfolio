---
/**
 * One featured service card. Only the explicit "Ask about this" text link is interactive (D-05):
 * the card itself has no pointer cursor, hover change or stretched link. The link's accessible
 * name is "Ask about this: Branding", so the 4 links are distinct and still start with the visible
 * label (WCAG 2.5.3). The whole name sits in one sr-only span and the visible label is
 * aria-hidden: Chromium inserts a space before an absolutely positioned sr-only fragment, which
 * read "Ask about this : Branding". The section builds the href with the stable service id (D-08).
 */
import IconArrowRight from '@tabler/icons/outline/arrow-right.svg';
import { interpolate, useTranslations, type Locale } from '../../i18n/t';

interface Props {
  title: string;
  items: readonly string[];
  href: string;
  locale: Locale;
}

const { title, items, href, locale } = Astro.props;
const t = useTranslations(locale);
---

<li class="flex flex-col items-start gap-5" data-reveal="settle" data-reveal-delay="140">
  <div class="flex w-full flex-wrap items-baseline justify-between gap-x-8 gap-y-2">
    <h3 class="font-display text-ink text-2xl font-semibold tracking-tight sm:text-4xl">{title}</h3>
    <p class="shrink-0">
      <a
        href={href}
        class="text-ink decoration-accent focus-visible:outline-accent inline-flex min-h-11 items-center gap-2 text-base font-semibold underline decoration-2 underline-offset-[6px] hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 motion-safe:transition-colors motion-safe:duration-150"
      >
        <span aria-hidden="true">{t('services.ask')}</span>
        <span class="sr-only">
          {t('services.ask')}
          {interpolate(t('services.askTarget'), { title })}
        </span>
        <IconArrowRight aria-hidden="true" focusable="false" class="size-5" />
      </a>
    </p>
  </div>
  <ul class="text-ink grid w-full max-w-3xl gap-x-8 gap-y-1 text-lead sm:grid-cols-2">
    {items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
</li>
