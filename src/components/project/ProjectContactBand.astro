---
import { getRelativeLocaleUrl } from 'astro:i18n';
import IconArrowRight from '@tabler/icons/outline/arrow-right.svg';
import ButtonLink from '../ui/ButtonLink.astro';
import { useTranslations, type Locale } from '../../i18n/t';

// Detail-page contact band (D-15): a field change to surface-alt, not a box. Its button is the
// page's only accent button and points at the Home contact section of the same locale.
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const contactHref = `${getRelativeLocaleUrl(locale, '/')}#contact`;
---

<section aria-labelledby="project-cta-title" class="bg-surface-alt">
  <div class="mx-auto flex max-w-[88rem] flex-col items-start gap-6 px-4 py-20 sm:px-8 md:flex-row md:items-end md:justify-between lg:px-12">
    <div class="flex flex-col gap-4">
      <h2
        id="project-cta-title"
        data-reveal="lines"
        class="font-display text-ink text-4xl font-semibold tracking-tight text-balance sm:text-5xl"
      >
        {t('detail.cta.heading')}
      </h2>
      <p data-reveal="settle" data-reveal-delay="140" class="text-ink text-lead max-w-[46ch]">
        {t('detail.cta.body')}
      </p>
    </div>
    <div data-reveal="settle" data-reveal-delay="210">
      <ButtonLink href={contactHref}>
        {t('detail.cta.button')}
        <Fragment slot="icon">
          <IconArrowRight aria-hidden="true" focusable="false" class="size-5" />
        </Fragment>
      </ButtonLink>
    </div>
  </div>
</section>
