---
import IconMail from '@tabler/icons/outline/mail.svg';
import IconBrandBehance from '@tabler/icons/outline/brand-behance.svg';
import IconBrandInstagram from '@tabler/icons/outline/brand-instagram.svg';
import IconBrandLinkedin from '@tabler/icons/outline/brand-linkedin.svg';
import IconLink from '../ui/IconLink.astro';
import { site } from '../../data/site';
import type { SiteConfig } from '../../data/site';
import { interpolate, useTranslations, type Locale } from '../../i18n/t';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
// Widen to the config type so optional socials stay optional until Martina provides them.
const socials: SiteConfig['socials'] = site.socials;
const newTab = t('a11y.newTab');
const copyright = interpolate(t('footer.copyright'), { year: new Date().getFullYear() });
---

<footer id="contact" class="bg-surface-alt py-12">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 sm:px-6 lg:px-8">
    <h2 class="font-display text-2xl">{t('footer.heading')}</h2>
    <p>
      <a
        href={`mailto:${site.email}`}
        class="decoration-accent focus-visible:outline-accent inline-flex min-h-11 items-center gap-1 text-base underline-offset-4 hover:underline focus-visible:underline focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        <IconMail aria-hidden="true" focusable="false" class="size-5" />
        {site.email}
      </a>
    </p>
    <ul class="flex gap-2">
      <li>
        <IconLink href={socials.behance} label={t('footer.behance')} newTabHint={newTab}>
          <IconBrandBehance aria-hidden="true" focusable="false" class="size-6" />
        </IconLink>
      </li>
      {socials.instagram && (
        <li>
          <IconLink href={socials.instagram} label={t('footer.instagram')} newTabHint={newTab}>
            <IconBrandInstagram aria-hidden="true" focusable="false" class="size-6" />
          </IconLink>
        </li>
      )}
      {socials.linkedin && (
        <li>
          <IconLink href={socials.linkedin} label={t('footer.linkedin')} newTabHint={newTab}>
            <IconBrandLinkedin aria-hidden="true" focusable="false" class="size-6" />
          </IconLink>
        </li>
      )}
    </ul>
    <p class="text-ink-muted text-base">{copyright}</p>
  </div>
</footer>
