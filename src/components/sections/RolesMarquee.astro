---
import IconAsterisk from '@tabler/icons/outline/asterisk.svg';
import { useTranslations, type Locale } from '../../i18n/t';

interface Props {
  roles: readonly string[];
  locale: Locale;
}

const { roles, locale } = Astro.props;
const t = useTranslations(locale);

// Pause control (user decision at the 02-08 checkpoint): no visible button. A transparent
// button covers the band as a sibling of the lists, so list semantics stay intact. Click/tap
// or Space/Enter toggles the pause (WCAG 2.2.2). Until the user makes that choice, mouse hover
// and keyboard focus pause transiently. The controller (lib/motion/marquee.ts) owns every pause
// source; data-paused is the only CSS pause selector. aria-pressed exposes only the explicit
// choice, so the first activation always pauses (08 WR-01, option-a); the transient hover/focus
// pause is visual only. Leaving the "on" motion state resets it (WR-03). White inset focus
// outline on the blue band (D-17). Hidden without motion.

// Shared by both copies. Without motion the first copy is a static wrapped list: it may shrink
// to the band width (shrink-0 only with motion), otherwise it keeps its one-line width and clips.
const copyClasses =
  'flex min-w-full flex-wrap items-center justify-center gap-x-[var(--marquee-gap)] gap-y-2 px-4 sm:px-6 lg:px-8 motion-on:shrink-0 motion-on:flex-nowrap motion-on:justify-around motion-on:px-0 motion-on:animate-marquee motion-reduce:animate-none group-data-paused:[animation-play-state:paused]';
const itemClasses =
  'inline-flex items-center gap-4 whitespace-nowrap font-display text-2xl font-semibold tracking-tight text-accent-ink xl:text-[1.875rem] 2xl:text-[2.5rem]';
---

<section
  aria-labelledby="roles-title"
  data-marquee
  class="group relative bg-accent py-6 text-accent-ink [--marquee-gap:2rem] lg:py-8"
>
  <h2 id="roles-title" class="sr-only">
    {t('roles.heading')}
  </h2>
  <div class="overflow-hidden">
    <div class="flex gap-[var(--marquee-gap)]">
      <ul class={copyClasses}>
        {roles.map((role) => (
          <li class={itemClasses}>
            <IconAsterisk
              aria-hidden="true"
              focusable="false"
              class="size-6 text-accent-ink/70 xl:size-7"
            />
            {role}
          </li>
        ))}
      </ul>
      <ul aria-hidden="true" class:list={[copyClasses, 'hidden motion-on:flex']}>
        {roles.map((role) => (
          <li class={itemClasses}>
            <IconAsterisk
              aria-hidden="true"
              focusable="false"
              class="size-6 text-accent-ink/70 xl:size-7"
            />
            {role}
          </li>
        ))}
      </ul>
    </div>
  </div>
  <button
    type="button"
    data-marquee-toggle
    aria-pressed="false"
    aria-label={t('roles.pause')}
    class="absolute inset-0 hidden cursor-pointer bg-transparent focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-accent-ink motion-on:block"
  ></button>
</section>

<script>
  import { lifecycle } from '../../lib/motion';
  import { initMarqueeToggles } from '../../lib/motion/marquee';
  lifecycle.register(initMarqueeToggles);
</script>
