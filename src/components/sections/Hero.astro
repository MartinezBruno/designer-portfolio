---
import { Picture } from 'astro:assets';
import IconArrowRight from '@tabler/icons/outline/arrow-right.svg';
import AvailabilityBadge from '../ui/AvailabilityBadge.astro';
import ButtonLink from '../ui/ButtonLink.astro';
import { site } from '../../data/site';
import { useTranslations, type Locale } from '../../i18n/t';
// TODO(martina): supply the original uncropped photo at >=1000px so the hero portrait can grow
import portrait from '../../assets/hero/portrait.png';

interface Props {
  locale: Locale;
  available: boolean;
}

const { locale, available } = Astro.props;
const t = useTranslations(locale);
---

<section aria-labelledby="hero-title" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
    <div class="flex flex-col gap-8 lg:col-span-7">
      <!-- Greeting is the headline: always exactly two lines, never an eyebrow above it. -->
      <h1 id="hero-title" class="font-display text-display -ml-[0.04em] font-semibold">
        <span class="block">{t('hero.greeting')}</span> <span class="block">{site.firstName}.</span>
      </h1>
      <p class="text-ink text-lead max-w-[55ch] text-pretty">
        {`${t('hero.role')} ${t('hero.description')}`}
      </p>
      <div class="flex flex-col items-start gap-x-6 gap-y-4 sm:flex-row sm:flex-wrap sm:items-center">
        <ButtonLink href="#contact">
          {t('hero.cta')}
          <Fragment slot="icon">
            <IconArrowRight aria-hidden="true" focusable="false" class="size-5" />
          </Fragment>
        </ButtonLink>
        <AvailabilityBadge available={available} locale={locale} />
      </div>
    </div>
    <div class="lg:col-span-5">
      <Picture
        src={portrait}
        formats={['avif', 'webp']}
        alt={t('hero.imageAlt')}
        loading="eager"
        fetchpriority="high"
        width={321}
        height={324}
        class="mx-auto aspect-square w-full max-w-64 rounded-full object-contain lg:max-w-80"
      />
    </div>
  </div>
</section>
