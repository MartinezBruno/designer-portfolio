---
import { Picture } from 'astro:assets';
import IconArrowLeft from '@tabler/icons/outline/arrow-left.svg';
import { useTranslations, type Locale } from '../../i18n/t';
import type { TeaserView } from '../../lib/projects/model';
import { pictureFormat } from '../../lib/ui/picture-format';

// Page-end teaser (D-13, D-14): "Next project" heading and the quiet "Previous" link on the left,
// the next project as a 7/12 tile on the right (same geometry as the Projects `large` tile). The
// tile is one tab stop: its title link is stretched over the whole tile. DOM order = visual order.
interface Props {
  next: TeaserView;
  /** Null with 2 visible projects: it would point at the same project as `next`. */
  previous: TeaserView | null;
  locale: Locale;
}

const { next, previous, locale } = Astro.props;
const t = useTranslations(locale);
---

<section aria-labelledby="next-project-title" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="grid grid-cols-1 gap-y-8 md:grid-cols-12 md:gap-x-6">
    <div class="flex flex-col items-start gap-6 md:col-span-5">
      <h2
        id="next-project-title"
        data-reveal="lines"
        class="font-display text-ink text-2xl font-semibold tracking-tight"
      >
        {t('detail.next.heading')}
      </h2>
      {previous !== null && (
        <div data-reveal="settle" data-reveal-delay="140">
          <a
            href={previous.href}
            class="text-ink decoration-accent focus-visible:outline-accent inline-flex min-h-11 items-center gap-2 text-base font-semibold decoration-2 underline-offset-4 hover:underline focus-visible:underline focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            <IconArrowLeft aria-hidden="true" focusable="false" class="size-5 shrink-0" />
            <span>
              {t('detail.previous')}{' '}
              {previous.titleLang === null ? (
                previous.title
              ) : (
                <span lang={previous.titleLang}>{previous.title}</span>
              )}
            </span>
          </a>
        </div>
      )}
    </div>
    <article class="group/card relative flex flex-col gap-4 md:col-span-7">
      <div
        data-reveal="shutter"
        data-reveal-delay="140"
        class="bg-surface-alt aspect-[5/4] overflow-hidden"
      >
        <Picture
          src={next.cover}
          alt={next.coverAlt}
          {...pictureFormat}
          widths={[404, 640, 808]}
          sizes="(min-width: 1152px) 625px, (min-width: 768px) 57vw, 100vw"
          width={next.cover.width}
          height={next.cover.height}
          loading="lazy"
          decoding="async"
          class="size-full object-cover object-center"
        />
      </div>
      <h3
        data-reveal="settle"
        data-reveal-delay="210"
        class="font-display text-ink text-4xl font-semibold tracking-tight text-pretty"
      >
        <a
          href={next.href}
          class="text-ink decoration-accent group-hover/card:underline focus-visible:after:outline-accent decoration-2 underline-offset-4 outline-hidden after:absolute after:inset-0 after:content-[''] focus-visible:underline focus-visible:after:outline-2 focus-visible:after:outline-offset-4"
        >
          <span class="sr-only">{t('detail.next.srPrefix')}</span>{' '}
          {next.titleLang === null ? next.title : <span lang={next.titleLang}>{next.title}</span>}
        </a>
      </h3>
    </article>
  </div>
</section>
