---
import '../styles/global.css';
import '../styles/smooth-scroll.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import type { Locale } from '../i18n/config';
import SkipLink from '../components/global/SkipLink.astro';
import SiteHeader from '../components/global/SiteHeader.astro';
import SiteFooter from '../components/global/SiteFooter.astro';
import CursorFollower from '../components/global/CursorFollower.astro';
import SeoHead from '../components/global/SeoHead.astro';
import type { PageKind } from '../lib/seo';
import { motionGateInline } from '../lib/motion/gate';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  kind?: PageKind;
  /** Absolute og:image URL (detail pages). */
  ogImage?: string;
}

const { locale, title, description, kind = 'page', ogImage } = Astro.props;
// Spread so pages without an ogImage pass no image prop at all (exactOptionalPropertyTypes).
const ogImageProp = ogImage ? { image: ogImage } : {};
// The ES 404 is rendered on demand by the Worker, so the request path must never reach shared components.
const pathname =
  kind === 'notFound' ? (locale === 'en' ? '/404/' : '/es/404/') : Astro.url.pathname;
---

<!doctype html>
<html lang={locale} data-motion="off" class="scroll-pt-24 sm:scroll-pt-20">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Blocking motion gate before any stylesheet: build-time constant, never user data. -->
    <script is:inline set:html={motionGateInline} />
    <!-- Soft navigation (Phase 7, MOTN-05): after the gate so hard loads resolve motion first.
         No transition:* directives anywhere (07 Research Pattern 3). -->
    <ClientRouter fallback="swap" />
    <SeoHead
      locale={locale}
      pathname={pathname}
      kind={kind}
      title={title}
      description={description}
      {...ogImageProp}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-bricolage" preload />
  </head>
  <body class="bg-surface text-ink font-sans antialiased">
    <SkipLink locale={locale} />
    <SiteHeader locale={locale} pathname={pathname} kind={kind} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <!-- Phase 7 ink wipe panel (07-02, D-01): parked off-screen, named only under 'on'. -->
    <div data-wipe-panel aria-hidden="true"></div>
    <CursorFollower locale={locale} />
    <script>
      import '../lib/motion';
      import '../lib/motion/effects';
    </script>
  </body>
</html>
