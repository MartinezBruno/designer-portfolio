---
/**
 * Project list in received order (D-18). Auto-flow row only: no dense packing, no explicit item
 * ordering and no row spanning, so DOM, tab and reading order all stay newest first. Tile sizes
 * come from tileSize(), or are all `third` for the fixed-count even row (`layout="row"`).
 */
import ProjectCard from './ProjectCard.astro';
import { tileSize } from '../../lib/projects/layout';
import type { ProjectCardView } from '../../lib/projects/model';
import type { Locale } from '../../i18n/t';

interface Props {
  projects: readonly ProjectCardView[];
  variant: 'compact' | 'full';
  headingLevel: 2 | 3;
  locale: Locale;
  /** Loads the first cover eagerly (the LCP candidate on the Projects page). */
  eagerFirst?: boolean;
  /** `row`: every tile spans 4 columns, for a fixed count of up to 3 (Home "Latest work"). */
  layout?: 'rhythm' | 'row';
}

const { projects, variant, headingLevel, locale, eagerFirst, layout = 'rhythm' } = Astro.props;
---

<ul
  class="grid grid-cols-1 gap-y-16 md:grid-cols-12 md:gap-x-8 lg:gap-y-24"
  data-reveal-stagger="90"
  data-project-grid
>
  {projects.map((project, index) => (
    <ProjectCard
      project={project}
      variant={variant}
      headingLevel={headingLevel}
      locale={locale}
      size={layout === 'row' ? 'third' : tileSize(index, projects.length)}
      eager={eagerFirst === true && index === 0}
    />
  ))}
</ul>
