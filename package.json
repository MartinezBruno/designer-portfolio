{
  "name": "designer-portfolio",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:offline": "ASTRO_TELEMETRY_DISABLED=1 NODE_OPTIONS=--import=./scripts/offline-guard.ts astro build --force && node scripts/assert-offline.ts",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "astro check && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "astro build && playwright test",
    "check:secrets": "node scripts/check-secrets.ts",
    "sync:behance": "node scripts/sync-behance.ts",
    "verify": "pnpm lint && pnpm test && pnpm test:e2e && pnpm check:secrets"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.1",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tabler/icons": "3.49.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/sanitize-html": "2.16.2",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.13.0",
    "happy-dom": "21.0.3",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.2"
  }
}
