---
/**
 * One project tile (D-19). No card box: the cover and text sit on the page surface. The title
 * link is stretched over the whole tile, so each card is a single tab stop. Detail pages land in
 * Phase 4 (D-09); until then the links 404 by design.
 */
import { Picture } from 'astro:assets';
import type { TileSize } from '../../lib/projects/layout';
import type { ProjectCardView } from '../../lib/projects/model';
import { useTranslations, type Locale } from '../../i18n/t';

interface Props {
  project: ProjectCardView;
  variant: 'compact' | 'full';
  headingLevel: 2 | 3;
  locale: Locale;
  /** Grid position size from tileSize() (D-18). */
  size: TileSize;
  /** Loads the cover eagerly with high fetch priority (the first Projects tile only). */
  eager: boolean;
}

const { project, variant, headingLevel, locale, size, eager } = Astro.props;
const t = useTranslations(locale);
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const full = variant === 'full';

// Literal class strings so Tailwind can see them (UI-SPEC ProjectGrid table).
const sizeClasses: Record<TileSize, string> = {
  large: 'md:col-span-7',
  small: 'md:col-span-5',
  'large-end': 'md:col-span-7 md:col-start-6',
  third: 'md:col-span-4',
};
const aspectClasses: Record<TileSize, string> = {
  large: 'aspect-[5/4]',
  small: 'aspect-[5/4] md:aspect-[7/8]',
  'large-end': 'aspect-[5/4]',
  third: 'aspect-[5/4]',
};
const sizesFor: Record<TileSize, string> = {
  large: '(min-width: 1152px) 625px, (min-width: 768px) 57vw, 100vw',
  small: '(min-width: 1152px) 440px, (min-width: 768px) 40vw, 100vw',
  'large-end': '(min-width: 1152px) 625px, (min-width: 768px) 57vw, 100vw',
  third: '(min-width: 1152px) 347px, (min-width: 768px) 31vw, 100vw',
};
// Spread so lazy covers carry no fetchpriority attribute at all (exactOptionalPropertyTypes).
const priority = eager ? { fetchpriority: 'high' as const } : {};
---

<li class={sizeClasses[size]}>
  <article class="group/card relative flex flex-col gap-4">
    <div class:list={['bg-surface-alt overflow-hidden', aspectClasses[size]]}>
      <Picture
        src={project.cover}
        alt={project.coverAlt}
        formats={['avif', 'webp']}
        widths={[404, 640, 808]}
        sizes={sizesFor[size]}
        width={project.cover.width}
        height={project.cover.height}
        loading={eager ? 'eager' : 'lazy'}
        {...priority}
        decoding="async"
        class="size-full object-cover object-center"
      />
    </div>
    <div class="flex flex-col gap-2">
      <Heading
        class:list={[
          'text-ink text-pretty',
          full ? 'font-display text-2xl font-semibold tracking-tight' : 'text-base font-semibold',
        ]}
      >
        <a
          href={project.href}
          class="text-ink decoration-accent group-hover/card:underline focus-visible:after:outline-accent decoration-2 underline-offset-4 outline-hidden after:absolute after:inset-0 after:content-[''] focus-visible:underline focus-visible:after:outline-2 focus-visible:after:outline-offset-4"
        >
          {project.titleLang === null ? (
            project.title
          ) : (
            <span lang={project.titleLang}>{project.title}</span>
          )}
        </a>
      </Heading>
      {full && project.summary !== null && (
        <p class="text-ink max-w-[60ch] text-base">{project.summary}</p>
      )}
      <dl class="text-ink-muted flex flex-wrap gap-x-4 gap-y-1 text-sm">
        {project.category !== null && (
          <div class="flex gap-1">
            <dt class="sr-only">{t('projects.meta.category')}</dt>
            <dd>{project.category}</dd>
          </div>
        )}
        <div class="flex gap-1">
          <dt class="sr-only">{t('projects.meta.year')}</dt>
          <dd>
            <time datetime={String(project.year)}>{project.year}</time>
          </dd>
        </div>
        {full && project.tools.length > 0 && (
          <div class="flex basis-full gap-1">
            <dt class="sr-only">{t('projects.meta.tools')}</dt>
            <dd>{project.tools.join(', ')}</dd>
          </div>
        )}
      </dl>
    </div>
  </article>
</li>
