---
// Availability pill (HOME-07). Renders nothing when available is false (D-08): no closed state.
import { useTranslations, type Locale } from '../../i18n/t';

interface Props {
  available: boolean;
  locale: Locale;
}

const { available, locale } = Astro.props;
const t = useTranslations(locale);
---

{available && (
  <p class="bg-surface-alt text-ink inline-flex items-center gap-2 self-start rounded-full px-4 py-2 text-sm font-semibold">
    <span aria-hidden="true" class="bg-success size-2 rounded-full" />
    {t('availability.open')}
  </p>
)}
